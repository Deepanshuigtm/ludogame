# ---- Server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ---- MongoDB (Atlas). Never ship this to the Android app – it lives only on the server.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ludogame

# ---- Firebase Admin (verifies sign-in tokens + sends push notifications)
# Firebase console → Project settings → Service accounts → Generate new private key, then:
#   save it as server/service-account.json (git-ignored) – or, on a host without files, base64 it into the variable below:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=voice-chat-56647

# ---- Email for offline invites (optional – leave SMTP_HOST empty to disable)
# Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true / an App Password. SendGrid: smtp.sendgrid.net / 587 / user "apikey".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ludo Classic <no-reply@yourdomain.com>
APP_DEEP_LINK=https://play.google.com/store/apps/details?id=com.ludoclassic

# ---- Game tuning
INVITE_TTL_SECONDS=600
TURN_TIMEOUT_SECONDS=25
RECONNECT_GRACE_SECONDS=60
MAX_FRIENDS=500
